#macro

	$DISABLE_COMMANDS = true


#source = files

	read pippetree.xml

#source = xpath

	$SHOW_SQL = false

	**xml = @content::.

	sistema_node = /node/select/node
	sistema_type = /node/select/node/option/@type
	sistema_value = /node/select/node/option/@value
	sistema_label = /node/select/node/option : textcontent

#target = oper.conf

	select assert(@sistema_type is not distinct from 'sistema', 'Tipo de nodo não é sistema')

#target = oper.conf

	$SHOW_SQL = true
	$LOG_SQL = true

	$LABEL = Novo sistema encontrado: @sistema_label !!!

	insert into pippe.sistema(id, nome) values (@sistema_value, @sistema_label) on conflict do nothing;


#source = xpath

	$SHOW_SQL = false

	**xml = @sistema_node::.
	
	ccr_node = /node/select/node
	ccr_type = /node/select/node/option/@type
	ccr_value = /node/select/node/option/@value
	ccr_label = /node/select/node/option : textcontent
	
#target = oper.conf

	select assert(@ccr_type is not distinct from 'ccr', 'Tipo de nodo não é ccr')
	
#target = oper.conf

	$SHOW_SQL = true
	$LOG_SQL = true

	$LABEL = Nova CCR encontrada: @sistema_label - @ccr_label !!!

	insert into pippe.ccr(id, nome, sistema) 
	values (split_part(@ccr_value, ' ', 1), @ccr_label, @sistema_value) 
	on conflict do update set nome = @ccr_label, sistema = @sistema_value;


#source = xpath

	$SHOW_SQL = true

	**xml = @ccr_node::.
	
	estacao_node = /node/select/node
	estacao_type = /node/select/node/option/@type
	estacao_value = /node/select/node/option/@value
	estacao_label = /node/select/node/option : textcontent

#target = oper.conf

	select assert(@estacao_type is not distinct from 'estacao', 'Tipo de nodo não é estacao')
	
#target = oper.conf

	$SHOW_SQL = true
	$LOG_SQL = true

	$LABEL = Nova Estação encontrada: @sistema_label - @ccr_label - @estacao_label !!!

	insert into pippe.estacao(id, nome, sistema, ccr) 
	values (split_part(@estacao_label, ' - ', 1), 
	        split_part(@estacao_label, ' - ', 2), 
			@sistema_value, 
			split_part(@ccr_value, ' ', 1)) 
	on conflict do update set nome = split_part(@estacao_label, ' - ', 2), 
		sistema = @sistema_value, ccr = split_part(@ccr_value, ' ', 1);


#source = xpath

	$SHOW_SQL = false

	**xml = @estacao_node::.
	
	variavel_type = /node/select/option/@type
	variavel_value = /node/select/option/@value
	variavel_label = /node/select/option : textcontent

	
#target = oper.conf

	select assert(@variavel_type is not distinct from 'variavel', 'Tipo de nodo não é variavel')
	
#target = oper.conf

	$SHOW_SQL = true
	$LOG_SQL = true

	$LABEL = Nova Variável encontrada: @sistema_label - @ccr_label - @estacao_label - @variavel_label !!!


	insert into pippe.variavel(tag, nome, estacao) 
	values (@variavel_value, @variavel_label, split_part(@estacao_label, ' - ', 1))
	on conflict do update set nome = split_part(@estacao_label, ' - ', 2), 
		sistema = @sistema_value, estacao = split_part(@estacao_label, ' - ', 1);
	