#source = files

	read pippetree.xml

#source = xpath

	$SHOW_SQL = false

	**xml = @content::.

	sistema_node = /node/select/node
	sistema_type = /node/select/node/option/@type
	sistema_value = /node/select/node/option/@value
	sistema_label = /node/select/node/option : textcontent

#target = dummy

	$SHOW_SQL = true
	$LOG_SQL = true

	$LABEL = Novo sistema encontrado: @sistema_label !!!

	insert sistema


